---
import Base from './Base.astro';
interface Props { title: string; summary: string; date: Date; meta?: [string, string][]; tags?: string[]; backLabel?: string; backHref?: string; prev?: { href: string; title: string }; next?: { href: string; title: string }; }
const { title, summary, date, meta = [], tags = [], backLabel = '← Index', backHref = '/#work', prev, next } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
---
<Base title={title} description={summary}>
  <main class="article">
    <a class="back mono" href={backHref} data-back>{backLabel}</a>
    <h1>{title}</h1>
    <p class="muted date">{dateStr}</p>
    {meta.length > 0 && (
      <dl class="meta">
        {meta.map(([k, v]) => <><dt class="mono muted">{k}</dt><dd>{v}</dd></>)}
      </dl>
    )}
    <div class="prose"><slot /></div>
    {(prev || next) && (
      <nav class="pn" aria-label="More projects">
        {prev ? <a href={prev.href}><span class="mono muted">← Previous</span><br />{prev.title}</a> : <span />}
        {next ? <a href={next.href}><span class="mono muted">Next →</span><br />{next.title}</a> : <span />}
      </nav>
    )}
  </main>
</Base>
<script>
  // "Back" returns to the page the visitor came from (restoring scroll) when it was the landing page.
  document.querySelector<HTMLAnchorElement>('[data-back]')?.addEventListener('click', (e) => {
    if (history.length > 1 && document.referrer && new URL(document.referrer).origin === location.origin) {
      e.preventDefault();
      history.back();
    }
  });
</script>
<style is:global>
  .article { max-width: var(--reading); margin: 0 auto; padding: 24px var(--gutter) 96px; }
  .article .back { text-decoration: none; color: var(--muted); }
  .article h1 { font: 500 20px/1.3 var(--font-body); margin: 48px 0 4px; letter-spacing: -0.01em; }
  .article .date { margin: 0 0 24px; }
  .article .meta { display: grid; grid-template-columns: 90px 1fr; gap: 6px 12px; margin: 0 0 32px; padding-bottom: 24px; border-bottom: 1px solid var(--rule); }
  .article .meta dd { margin: 0; }
  .article .prose h2 { font: 500 15px/1.4 var(--font-body); margin: 48px 0 8px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .article .prose p, .article .prose li { margin: 0 0 16px; }
  .article .prose pre { background: #f0eee8; padding: 14px 16px; overflow-x: auto; border-radius: 6px; font: 12.5px/1.6 var(--font-mono); }
  .article .prose code { font-family: var(--font-mono); font-size: 0.9em; }
  .article .prose table { width: 100%; border-collapse: collapse; margin: 24px 0; font-size: 13px; }
  .article .prose th, .article .prose td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--rule); }
  .article .pn { display: flex; justify-content: space-between; gap: 16px; margin-top: 72px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .article .pn a { text-decoration: none; }
  .article .pn a:last-child { text-align: right; }
</style>
