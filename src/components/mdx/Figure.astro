---
interface Props { src: string; alt?: string; caption?: string; video?: boolean; }
const { src, alt = '', caption, video = false } = Astro.props;
---
<figure>
  {video ? <video src={src} autoplay loop muted playsinline aria-label={alt}></video> : <img src={src} alt={alt} loading="lazy" />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  figure { margin: 32px 0; }
  figcaption { margin-top: 8px; font-size: 12px; color: var(--muted); }
</style>
