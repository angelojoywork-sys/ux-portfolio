---
import { site } from '../data/site';
---
<section class="hero" id="top">
  <h1 aria-label={site.headline.join(' ')}>
    {site.headline.map((line) => <span class="line" aria-hidden="true"><span class="inner">{line}</span></span>)}
  </h1>
  {site.heroImage && <img class="object" src={site.heroImage} alt="Liquid chrome smart glasses" />}
</section>
<style>
  .hero {
    min-height: calc(100svh - 64px);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 2vh var(--gutter) 4vh; overflow: hidden;
  }
  h1 {
    position: relative; z-index: 2; margin: 0; text-align: center;
    font: 700 clamp(40px, 7.5vw, 112px)/1.02 var(--font-display); letter-spacing: -0.02em;
  }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .inner { display: inline-block; }
  .object {
    position: relative; z-index: 1;
    width: min(52vw, 580px); margin-top: -7vh;
    mix-blend-mode: multiply; filter: brightness(1.1) contrast(1.05);
    -webkit-mask-image: radial-gradient(ellipse 62% 62% at 50% 50%, #000 55%, transparent 100%);
    mask-image: radial-gradient(ellipse 62% 62% at 50% 50%, #000 55%, transparent 100%);
  }
  @media (max-width: 720px) { .object { width: 80vw; } }
</style>
