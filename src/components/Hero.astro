---
import { site } from '../data/site';
---
<section class="hero" id="top">
  <h1 aria-label={site.headline.join(' ')}>
    {site.headline.map((line) => <span class="line" aria-hidden="true"><span class="inner">{line}</span></span>)}
  </h1>
  {site.heroImage && <img class="object" src={site.heroImage} alt="Liquid chrome smart glasses" />}
</section>
<style>
  .hero {
    position: relative; overflow: hidden;
    height: calc(100svh - 64px); min-height: 520px;
    padding: 0 var(--gutter);
    display: flex; align-items: center; justify-content: center;
  }
  h1 {
    margin: 0; padding-bottom: 6vh; text-align: center;
    font: 700 clamp(40px, 8.6vw, 132px)/1.02 var(--font-display); letter-spacing: -0.02em;
  }
  .line { display: block; overflow: hidden; padding-bottom: 0.08em; }
  .inner { display: inline-block; }
  /* In front of the headline, resting on the bottom edge of the screen */
  .object {
    position: absolute; z-index: 2; left: 0; right: 0; margin-inline: auto; bottom: -1%;
    width: min(58vw, 820px);
  }
  @media (max-width: 720px) { .object { width: 120vw; } }
</style>
