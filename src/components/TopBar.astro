---
import { site } from '../data/site';
const links = [
  { href: '#overview', label: '/01 Overview' },
  { href: '#work', label: '/02 Work' },
  { href: '#about', label: '/03 About' },
  { href: '#archives', label: '/04 Archives' },
];
---
<header class="topbar">
  <div class="grid mono">
    <div class="c1">
      <div>{site.name}</div>
      <div class="muted">{site.role}</div>
    </div>
    <div class="c2">
      <div>{site.location}</div>
      <div class="muted"><span data-clock data-tz={site.timeZone}>--:--</span> local</div>
    </div>
    <nav class="c3 links" aria-label="Sections">
      {links.map((l) => <a href={l.href} data-nav>{l.label}</a>)}
    </nav>
    <div class="c4">
      <div>Contact</div>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</header>
<style>
  .topbar { position: sticky; top: 0; z-index: 10; padding-block: 20px 12px; background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(8px); }
  .grid { row-gap: 14px; }
  .c1 { grid-column: span 3; } .c2 { grid-column: span 4; } .c3 { grid-column: span 3; } .c4 { grid-column: span 2; }
  .links { display: flex; flex-direction: column; }
  .links a, .c4 a { text-decoration: none; }
  .links a[aria-current='true'] { color: var(--accent); }
  @media (max-width: 1100px) { .c1, .c2, .c3, .c4 { grid-column: span 3; } }
  @media (max-width: 720px) { .c1, .c2, .c3, .c4 { grid-column: span 6; } }
</style>
