---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import Figure from '../../components/mdx/Figure.astro';
import Pair from '../../components/mdx/Pair.astro';
import Gallery from '../../components/mdx/Gallery.astro';
import Steps from '../../components/mdx/Steps.astro';
import Callout from '../../components/mdx/Callout.astro';
import Footnote from '../../components/mdx/Footnote.astro';
import Note from '../../components/mdx/Note.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('work', (e) => !e.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: entries[i + 1] && { href: `/work/${entries[i + 1].id}/`, title: entries[i + 1].data.title },
      next: entries[i - 1] && { href: `/work/${entries[i - 1].id}/`, title: entries[i - 1].data.title },
    },
  }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d: any = entry.data;
const meta: [string, string][] = d.role ? [['Role', d.role], ['Timeframe', d.timeframe], ['Tags', d.tags.join(', ')]] : [];
---
<Article title={d.title} summary={d.summary} date={d.date} meta={meta} backHref="/#work" backLabel="← Index" prev={prev} next={next}>
  <Content components={{ Figure, Pair, Gallery, Steps, Callout, Footnote, Note }} />
</Article>
